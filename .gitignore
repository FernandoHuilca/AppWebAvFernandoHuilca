# --- Logs y archivos temporales de compilación ---
*.log
*.tlog
*.ilk
*.cache
*.tmp
*.suo.tmp

# --- NuGet ---
packages/
*.nupkg
*.snupkg

# --- Herramientas / IDEs ---
.vscode/
.idea/
_ReSharper*/
*.[Rr]e[Ss]harper
.ncrunch*
.*crunch*.local.xml
nCrunchTemp_*
*.ghostdoc.*
