# --- Archivos de configuración local de MSBuild ---
*.binlog
msbuild.log
*.wrn
*.err

# --- Base de datos / respuestos locales ---
*.mdf
*.ldf
*.ndf
*.bak
*.bak2

# --- Temporales de Office (documentos abiertos) ---
~$*

